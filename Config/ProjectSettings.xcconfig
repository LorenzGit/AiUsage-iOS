// Checked-in defaults for identifiers and signing. Override locally in
// Config/Local.xcconfig without modifying tracked project files.

PRODUCT_BUNDLE_IDENTIFIER_PREFIX = com.example.aiusage
DEVELOPMENT_TEAM_ID =

#include? "Local.xcconfig"

APP_BUNDLE_IDENTIFIER = $(PRODUCT_BUNDLE_IDENTIFIER_PREFIX)
WIDGET_BUNDLE_IDENTIFIER = $(PRODUCT_BUNDLE_IDENTIFIER_PREFIX).AiUsageWidgetExtension
WATCH_BUNDLE_IDENTIFIER = $(PRODUCT_BUNDLE_IDENTIFIER_PREFIX).watchkitapp
TEST_BUNDLE_IDENTIFIER = $(PRODUCT_BUNDLE_IDENTIFIER_PREFIX).AiUsageTests
APP_GROUP_IDENTIFIER = group.$(PRODUCT_BUNDLE_IDENTIFIER_PREFIX)
SHARED_KEYCHAIN_ACCESS_GROUP = $(PRODUCT_BUNDLE_IDENTIFIER_PREFIX).shared
